CREATE TABLE LibraryItem (
    type TEXT NOT NULL,
    tmdbId INTEGER NOT NULL,
    name TEXT NOT NULL,
    year INTEGER,
    posterPath TEXT,
    imdbId TEXT,
    genres TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL,
    completion REAL NOT NULL DEFAULT 0.0,
    abandoned INTEGER NOT NULL DEFAULT 0,
    addedAt INTEGER NOT NULL,
    lastActivityAt INTEGER NOT NULL,
    PRIMARY KEY (type, tmdbId)
);

CREATE TABLE UserRating (
    type TEXT NOT NULL,
    tmdbId INTEGER NOT NULL,
    score INTEGER NOT NULL CHECK (score BETWEEN 0 AND 100),
    ratedAt INTEGER NOT NULL,
    PRIMARY KEY (type, tmdbId)
);

-- One current vote per title; a new vote replaces the old one.
CREATE TABLE InterestVoteRow (
    type TEXT NOT NULL,
    tmdbId INTEGER NOT NULL,
    vote TEXT NOT NULL,
    source TEXT NOT NULL,
    atMillis INTEGER NOT NULL,
    genres TEXT NOT NULL DEFAULT '',
    keywords TEXT NOT NULL DEFAULT '',
    castIds TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (type, tmdbId)
);

CREATE TABLE ActorPref (
    personId INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    pref TEXT NOT NULL
);

CREATE TABLE Setting (
    k TEXT NOT NULL PRIMARY KEY,
    v TEXT NOT NULL
);

CREATE TABLE EpisodeWatch (
    tmdbId INTEGER NOT NULL,
    season INTEGER NOT NULL,
    episode INTEGER NOT NULL,
    watchedAt INTEGER NOT NULL,
    PRIMARY KEY (tmdbId, season, episode)
);

-- episode = 0 holds the season catch-up text.
CREATE TABLE EpisodeSummary (
    tmdbId INTEGER NOT NULL,
    season INTEGER NOT NULL,
    episode INTEGER NOT NULL,
    lang TEXT NOT NULL,
    promptVersion INTEGER NOT NULL,
    text TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    PRIMARY KEY (tmdbId, season, episode, lang)
);

CREATE TABLE SyncEvent (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    at INTEGER NOT NULL,
    service TEXT NOT NULL,
    item TEXT NOT NULL,
    action TEXT NOT NULL,
    localTs INTEGER,
    remoteTs INTEGER
);

CREATE TABLE RatingCache (
    imdbId TEXT NOT NULL PRIMARY KEY,
    imdb REAL,
    rottenTomatoes INTEGER,
    fetchedAt INTEGER NOT NULL
);

insertLibraryIfMissing:
INSERT OR IGNORE INTO LibraryItem(type, tmdbId, name, year, posterPath, imdbId, genres, status, completion, abandoned, addedAt, lastActivityAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateProgress:
UPDATE LibraryItem SET status = ?, completion = ?, abandoned = ?, lastActivityAt = ? WHERE type = ? AND tmdbId = ?;

selectLibrary:
SELECT * FROM LibraryItem;

deleteLibraryItem:
DELETE FROM LibraryItem WHERE type = ? AND tmdbId = ?;

upsertRating:
INSERT OR REPLACE INTO UserRating(type, tmdbId, score, ratedAt) VALUES (?, ?, ?, ?);

selectRatings:
SELECT * FROM UserRating;

upsertVote:
INSERT OR REPLACE INTO InterestVoteRow(type, tmdbId, vote, source, atMillis, genres, keywords, castIds)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectVotes:
SELECT * FROM InterestVoteRow;

deleteVote:
DELETE FROM InterestVoteRow WHERE type = ? AND tmdbId = ?;

upsertActor:
INSERT OR REPLACE INTO ActorPref(personId, name, pref) VALUES (?, ?, ?);

deleteActor:
DELETE FROM ActorPref WHERE personId = ?;

selectActors:
SELECT * FROM ActorPref;

getSetting:
SELECT v FROM Setting WHERE k = ?;

putSetting:
INSERT OR REPLACE INTO Setting(k, v) VALUES (?, ?);

markEpisodeWatched:
INSERT OR REPLACE INTO EpisodeWatch(tmdbId, season, episode, watchedAt) VALUES (?, ?, ?, ?);

unmarkEpisodeWatched:
DELETE FROM EpisodeWatch WHERE tmdbId = ? AND season = ? AND episode = ?;

selectWatchedEpisodes:
SELECT season, episode FROM EpisodeWatch WHERE tmdbId = ?;

upsertSummary:
INSERT OR REPLACE INTO EpisodeSummary(tmdbId, season, episode, lang, promptVersion, text, createdAt) VALUES (?, ?, ?, ?, ?, ?, ?);

selectSummary:
SELECT text, promptVersion FROM EpisodeSummary WHERE tmdbId = ? AND season = ? AND episode = ? AND lang = ?;

insertSyncEvent:
INSERT INTO SyncEvent(at, service, item, action, localTs, remoteTs) VALUES (?, ?, ?, ?, ?, ?);

selectRecentSyncEvents:
SELECT * FROM SyncEvent ORDER BY id DESC LIMIT ?;

updateProgressAt:
UPDATE LibraryItem SET status = ?, completion = ?, abandoned = 0, lastActivityAt = ? WHERE type = ? AND tmdbId = ?;

upsertRatingCache:
INSERT OR REPLACE INTO RatingCache(imdbId, imdb, rottenTomatoes, fetchedAt) VALUES (?, ?, ?, ?);

selectRatingCache:
SELECT * FROM RatingCache WHERE imdbId = ?;

upsertLibrary:
INSERT OR REPLACE INTO LibraryItem(type, tmdbId, name, year, posterPath, imdbId, genres, status, completion, abandoned, addedAt, lastActivityAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllWatchedEpisodes:
SELECT * FROM EpisodeWatch;

updateImdbId:
UPDATE LibraryItem SET imdbId = ? WHERE type = ? AND tmdbId = ?;
