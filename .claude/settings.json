{
  "permissions": {
    "deny": [
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(**/*.keystore)",
      "Read(signing/*.p12)",
      "Read(./.env)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ./gradlew ]; then ./gradlew check 1>&2 || exit 2; fi"
          }
        ]
      }
    ]
  }
}
